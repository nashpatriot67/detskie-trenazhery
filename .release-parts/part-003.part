const glyphs={book:'<path d="M3 5q5-2 9 1 4-3 9-1v15q-5-2-9 1-4-3-9-1ZM12 6v15"/>',letters:'<path d="m3 19 6-14 6 14M5 14h8m5-3v8m0-5c5-5 7 4 0 5"/>',puzzle:'<path d="M4 4h6v3a2 2 0 1 0 4 0V4h6v6h-3a2 2 0 1 0 0 4h3v6h-6v-3a2 2 0 1 0-4 0v3H4v-6h3a2 2 0 1 0 0-4H4Z"/>',tree:'<path d="M12 4v6M5 20v-5h14v5M12 10v10"/><rect x="7" y="2" width="10" height="5" rx="1"/><rect x="2" y="18" width="6" height="4" rx="1"/><rect x="9" y="18" width="6" height="4" rx="1"/><rect x="16" y="18" width="6" height="4" rx="1"/>',build:'<path d="M3 4h7v6H3Zm11 0h7v6h-7ZM3 14h7v6H3Zm11 0h7v6h-7Z"/>',magic:'<path d="m4 20 13-13 3 3L7 23ZM14 3v-2M20 4l2-2M22 9h2M5 7V3M3 5h4M9 15v-4M7 13h4"/>',chat:'<path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-4-1l-5 1 1-5a9 9 0 1 1 17-4Z"/><path d="M8 10h8M8 14h5"/>',chart:'<path d="M4 3v17h17M9 16v-4M14 16V8M19 16V4"/>',sound:'<path d="m10 4-5 5H2v6h3l5 5ZM14 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/>',mic:'<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/>',check:'<path d="m5 12 4 4L19 6"/>',arrow:'<path d="M4 12h16m-6-6 6 6-6 6"/>',back:'<path d="M20 12H4m6-6-6 6 6 6"/>',star:'<path d="m12 3 3 6 6 1-4.5 4.5 1 6L12 18l-5.5 2.5 1-6L3 10l6-1Z"/>',bulb:'<path d="M9 18h6m-5 3h4M8 14a6 6 0 1 1 8 0c-1 1-1 2-1 2H9s0-1-1-2Z"/>',close:'<path d="m6 6 12 12M6 18 18 6"/>',reset:'<path d="M4 10a8 8 0 1 1 1 7M4 4v6h6"/>',home:'<path d="m3 10 9-7 9 7v11h-7v-7h-4v7H3Z"/>',help:'<circle cx="12" cy="12" r="9"/><path d="M9 9a3 3 0 1 1 4 3v2M12 17h.01"/>',stop:'<rect x="6" y="6" width="12" height="12" rx="2"/>'};
