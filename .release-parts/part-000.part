const MARKUP="<div id=\"room-mission-play\">\n  <section class=\"rg-game\" aria-label=\"Операция: готов к выходу\">\n    <nav class=\"rg-page-nav\" aria-label=\"Навигация\"><a href=\"./\">← Все приключения</a><a href=\"../\">Все игры</a></nav><header class=\"rg-header\"><span class=\"rg-brand\">Дела и приключения</span><h2>Готов к приключению!</h2><p>Помоги роботу Рэю навести порядок и собраться в бассейн.</p></header>\n    <div class=\"rg-route\" aria-label=\"Маршрут приключения\"><span data-rg-pip=\"floor\">Проход</span><span aria-hidden=\"true\">→</span><span data-rg-pip=\"bed\">Постель</span><span aria-hidden=\"true\">→</span><span data-rg-pip=\"bag\">Сумка</span></div>\n    <div class=\"rg-scene\" data-rg-scene>\n      <canvas data-rg-canvas aria-label=\"Комната с предметами для перетаскивания. Можно также выбрать предмет и нажать на подходящее место.\"></canvas>\n      <div class=\"rg-hits\" data-rg-hits></div>\n      <div class=\"rg-intro\" data-rg-intro><div><span class=\"rg-overline\">МИССИЯ РЭЯ</span><h3>Вещи перепутались</h3><p>Освободим проход, приведём постель в порядок и найдём вещи для бассейна.</p><button class=\"rg-main cursor-interaction\" type=\"button\" data-rg-start disabled>Готовим комнату…</button></div></div>\n      <div class=\"rg-ending\" data-rg-ending hidden><div><span class=\"rg-overline\">МИССИЯ ВЫПОЛНЕНА</span><h3>Можно отправляться!</h3><p>Проход свободен, постель аккуратная, сумка собрана.</p><button type=\"button\" class=\"rg-main cursor-interaction\" data-rg-replay>Сыграть ещё раз</button></div></div>\n    </div>\n    <div class=\"rg-story\"><strong data-rg-title>Освободи проход</strong><p data-rg-feedback role=\"status\" aria-live=\"polite\">В комнате есть игрушки и футболка после спорта. Найдём им места.</p></div>\n    <p class=\"rg-save-status\" data-rg-save role=\"status\"></p><div class=\"rg-tools\"><button type=\"button\" class=\"rg-tool cursor-interaction\" data-rg-memo hidden>Что взять?</button><button type=\"button\" class