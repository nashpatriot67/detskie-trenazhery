";
function makeData(){
 const q=global.LifeQuestData.quests.find(q=>q.id==='life.sport.pool');
 if(!q)throw Error('Missing reviewed pool activity');
 const floor={items:['toy-car','teddy','dirty-shirt'],accepted:{'toy-car':['toybox'],teddy:['toybox'],'dirty-shirt':['laundry']}};
 const data={pool:{required:q.required.slice(),optional:q.optional.slice(),distractors:q.distractors.slice(),why:{...q.why}},floor,items:{},art:{},atlas:ATLAS};
 for(const id of new Set(floor.items.concat(q.required,q.optional,q.distractors))){data.items[id]=global.LifeQuestData.items[id];if(!global.ObjectArt.has(id))throw Error('Missing object illustration: '+id);data.art[id]='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(global.ObjectArt.markup(id,{decorative:true}));}
 return data;
}
const mount=(function(host){
  'use strict';
  host.innerHTML=MARKUP;
  const store=window.RoomProgress.create();
  const root=document.getElementById('room-mission-play'),data=makeData();
  const canvas=root.querySelector('[data-rg-canvas]'),ctx=canvas.getContext('2d'),scene=root.querySelector('[data-rg-scene]'),hits=root.querySelector('[data-rg-hits]'),intro=root.querySelector('[data-rg-intro]'),startButton=root.querySelector('[data-rg-start]'),ending=root.querySelector('[data-rg-ending]'),feedback=root.querySelector('[data-rg-feedback]'),heading=root.querySelector('[data-rg-title]'),drawer=root.querySelector('[data-rg-drawer]');
  const W=720,TAU=Math.PI*2,stageIndex={floor:0,bed:1,bag:2,done:2};
  const titles={floor:'Освободи проход',bed:'Заправь постель',bag:'Собери сумку в бассейн',done:'Теперь можно отправляться'};
  const instructions={floor:'Игрушки — в ящик. Футболку после спорта — в корзину для белья. Можно перетаскивать или выбирать нажатием.',bed:'Расправь покрывало за два уголка и положи подушку. Метки покажут подходящее место.',bag:'Найди вещи по памятке бассейна. В конце застегни молнию на сумке.',done:'Все три дела закончены. Настоящее дело можно попробовать повторить дома.'};
  let started=false,loaded=false,visible=!document.hidden,intersecting=true,raf=0,last=0,clock=0,frames=0,displayStage='floor',camera=0,transition=null,drag=null,selected=null,scale=1,drawers=null,suppressUntil=0,hover=null,soundEnabled=false,audio=null,finished=false,finishAt=0;
  let sprites=[],corners=[],zipProgress=0,particles=[],feedbackOverride='',regionList=[],suppressDropClick=false;
  const actor=AdventureActor.create({x:80,y:694,scale:1.45}),images={};
  const reduced=window.matchMedia?.('(prefers-reduced-motion: reduce)').matches===true;
  const game=RoomAdventure.create(data);
  const initialSave=store.read(),prior=initialSave.snapshot;
  if(prior)try{game.restore(prior);}catch(_){}
  displayStage=game.state.stage;camera=stageIndex[displayStage];finished=false;
  function saveNotice(){const node=root.querySelector('[data-rg-save]');if(node)node.textContent=store.warning()||'Сохраняем на этом устройстве · можно продолжить позже';}
  function persist(){store.save(game.snapshot(),{sound:soundEnabled});saveNotice();}
  saveNotice();
  function image(src){return new Promise(resolve=>{const img=new Image();img.onload=()=>resolve(img);img.onerror=()=>resolve(null);img.src=src;});}
  let atlas=null;
  const ensureAudio=()=>{if(!audio)try{const AC=window.AudioContext||window.webkitAudioContext;if(AC)audio=new AC();}catch(_){}if(audio?.state==='suspended')audio.resume().catch(()=>{});};
  function tone(kind){if(!soundEnabled||!audio||!visible)return;try{const t=audio.currentTime,o=audio.createOscillator(),g=audio.createGain();o.type=kind==='step'?'triangle':'sine';o.frequency.setValueAtTime(kind==='step'?140:kind==='success'?740:440,t);o.frequency.exponentialRampToValueAtTime(kind==='step'?90:kind==='success'?990:390,t+.09);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(kind==='step'?.018:.065,t+.01);g.gain.exponentialRampToValueAtTime(.0001,t+.13);o.connect(g);g.connect(audio.destination);o.start(t);o.stop(t+.15);}catch(_){}}
  const label=id=>data.items[id]?.label||id;
  function sprite(id,x,y,w=116,h=116){return {id,x,y,tx:x,ty:y,ox:x,oy:y,w,h,vx:0,vy:0,angle:0,ta:0,s:1,ts:1,alpha:1,grabbed:false};}
  function setup(stage){
    const state=game.state;drag=null;selected=null;hover=null;zipProgress=state.zip?1:0;particles=[];
    if(stage==='floor'){
      sprites=[sprite('toy-car',350,625,126,126),sprite('teddy',510,625,116,116),sprite('dirty-shirt',390,475,120,120)];
      for(const s of sprites)if(state.placements[s.id]){const p=floorDestination(s.id,state.placements[s.id]);Object.assign(s,{x:p.x,y:p.y,tx:p.x,ty:p.y,s:.55,ts:.55});}
      actor.x=state.placements['toy-car']?(state.placements.teddy?550:350):80;actor.y=694;
    }else if(stage==='bed'){
      sprites=[sprite('pillow',650,650,140,80)];if(state.pillow)Object.assign(sprites[0],{x:360,y:334,tx:360,ty:334});else sprites[0].angle=-.18;
      corners=[{x:235,y:510,tx:235,ty:510,vx:0,vy:0},{x:520,y:535,tx:520,ty:535,vx:0,vy:0}];corners.forEach((p,i)=>{if(state.blanket[i])Object.assign(p,{x:i?530:200,y:355,tx:i?530:200,ty:355});});
      actor.x=88;actor.y=685;
    }else{
      sprites=data.pool.required.concat(data.pool.optional,data.pool.distractors).map((id,i)=>sprite(id,70+(i%5)*140,i<5?65:205,110,110));
      actor.x=92;actor.y=680;
    }
    actor.update(0,{targetX:actor.x,targetY:actor.y,mood:'idle',reducedMotion:true});
  }
  function floorDestination(id,zone){return zone==='laundry'?{x:625,y:430}:{x:id==='teddy'?177:103,y:397};}
  const ready=()=>data.pool.required.every(id=>game.state.packed.includes(id));
  function esc(value){return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  function updateUI(){
    const state=game.state;
    heading.textContent=titles[displayStage];feedback.textContent=feedbackOverride||instructions[displayStage];
    root.querySelectorAll('[data-rg-pip]').forEach(el=>{const n=stageIndex[el.dataset.rgPip],active=stageIndex[displayStage];el.classList.toggle('is-current',n===active&&displayStage!=='done');el.classList.toggle('is-complete',n<active||displayStage==='done');});
    root.querySelector('[data-rg-memo]').hidden=displayStage!=='bag'||!started;
    root.querySelector('[data-rg-bag]').hidden=displayStage!=='bag'||!started;
    ending.hidden=!finished;
    startButton.disabled=!loaded;startButton.textContent=prior?'Продолжить приключение':'Начать приключение';
    rebuildHits();
  }
  function makeRegion(kind,id,x,y,w=90,h=90,target){return {kind,id,item:kind==='zone'?null:id,target:target||null,x,y,w,h};}
  function regions(){
    const state=game.state,out=[];if(!started||transition||displayStage==='done'||finished)return out;
    if(displayStage==='floor'){
      for(const s of sprites)if(!state.placements[s.id])out.push(makeRegion('object',s.id,s.ox,s.oy,s.w,s.h));
      out.push(makeRegion('zone','toybox',150,410,260,190,'toybox'),makeRegion('zone','laundry',625,445,145,150,'laundry'));
    }else if(displayStage==='bed'){
      corners.forEach((p,i)=>{if(!state.blanket[i])out.push(makeRegion('corner','corner-'+i,p.tx,p.ty,65,65),makeRegion('zone','corner-'+i,i?530:200,355,65,65,'corner-'+i));});
      if(!state.pillow)out.push(makeRegion('pillow','pillow',650,650,140,80),makeRegion('zone','pillow-target',360,334,160,85,'pillow-target'));
    }else if(displayStage==='bag'){
      for(const s of sprites)if(!state.packed.includes(s.id))out.push(makeRegion('object',s.id,s.ox,s.oy,s.w,s.h));
      out.push(makeRegion('zone','bag',360,630,220,75,'bag'),makeRegion('zip','zip',250+230*zipProgress,500,65,65),makeRegion('zone','zip-end',480,500,65,65,'zip-end'));
    }
    return out;
  }
  function rebuildHits(){
    const focused=hits.contains(document.activeElement)?{kind:document.activeElement.dataset.rgKind,id:document.activeElement.dataset.rgItem||document.activeElement.dataset.rgTarget}:null;
    regionList=regions();hits.innerHTML=regionList.map(r=>{
      const text=r.kind==='zone'?({'toybox':'Ящик для игрушек',laundry:'Корзина для белья',bag:'Положить в сумку','pillow-target':'Место для подушки','corner-0':'Метка левого угла','corner-1':'Метка правого угла','zip-end':'Дотянуть молнию до конца'}[r.id]||r.id):r.kind==='corner'?'Потянуть '+(r.id==='corner-0'?'левый':'правый')+' угол покрывала':r.kind==='zip'?'Потянуть молнию':r.kind==='pillow'?'Подушка':label(r.id);
      return '<button type="button" class="rg-hit cursor-interaction" data-rg-kind="'+r.kind+'" '+(r.kind==='zone'?'data-rg-target="'+r.target+'"':'data-rg-item="'+r.item+'"')+' aria-label="'+esc(text)+'" style="left:'+r.x/7.2+'%;top:'+r.y/7.2+'%;width:'+Math.max(44,r.w*scale)+'px;height:'+Math.max(44,r.h*scale)+'px"><span class="rg-hidden-label">'+esc(text)+'</span></button>';
    }).join('');
    if(focused){const next=Array.from(hits.children).find(el=>el.dataset.rgKind===focused.kind&&(el.dataset.rgItem||el.dataset.rgTarget)===focused.id);next?.focus({preventScroll:true});}
  }
  function resize(){
    const w=scene.clientWidth;if(!w)return;scale=w/W;const dpr=Math.min(window.devicePixelRatio||1,2.5);canvas.width=Math.round(w*dpr);canvas.height=Math.round(w*dpr);ctx.setTransform(dpr*scale,0,0,dpr*scale,0,0);rebuildHits();draw();
  }
  const roundRect=(x,y,w,h,r,fill,stroke)=>{ctx.beginPath();if(ctx.roundRect)ctx.roundRect(x,y,w,h,r);else{r=Math.min(r,w/2,h/2);ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}if(fill){ctx.fillStyle=fill;ctx.fill();}if(stroke){ctx.strokeStyle=stroke;ctx.stroke();}};
  function chip(text,x,y,accent=false){
    ctx.save();ctx.font=(13/scale)+'px "Trebuchet MS",Arial,sans-serif';const tw=ctx.measureText(text).width,pad=7/scale,h=25/scale;x=Math.max(tw/2+pad+4,Math.min(W-tw/2-pad-4,x));roundRect(x-tw/2-pad,y-h/2,tw+pad*2,h,8/scale,accent?'#e5fff0eb':'#fffdf1ed','#405b3620');ctx.fillStyle='#2b493e';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,x,y);ctx.restore();
  }
  function burst(x,y,color='#f4d079'){if(reduced)return;for(let i=0;i<11;i++){const a=Math.random()*TAU,s=45+Math.random()*90;particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-40,life:.7,size:3+Math.random()*4,color});}}
  function drawSprite(s){
    if(s.alpha<=0)return;ctx.save();ctx.translate(s.x,s.y);ctx.rotate(s.angle);ctx.scale(s.s,s.s);ctx.globalAlpha=s.alpha;
    if(s.grabbed){ctx.shadowColor='#183e3840';ctx.shadowBlur=15;ctx.shadowOffsetY=8;}
    if(s.id==='pillow')AdventureProps.pillow(ctx,{x:0,y:0,width:s.w,height:s.h,angle:0});
    else if(global.RoomToyArt?.legacy(s.id))global.RoomToyArt.drawItem(ctx,global.RoomToyArt.legacy(s.id),{x:0,y:0,size:s.w});
    else if(images[s.id])ctx.drawImage(images[s.id],-s.w/2,-s.h/2,s.w,s.h);
    else{roundRect(-s.w/2,-s.h/2,s.w,s.h,12,'#b7d4c3');}
    ctx.restore();
  }
  function drawTargets(){
    if(!started||transition||displayStage==='done')return;
    ctx.save();ctx.lineWidth=3;ctx.setLineDash([7,6]);
    if(displayStage==='floor'){
      for(const r of regionList.filter(r=>r.kind==='zone')){
        const active=!!selected||!!drag;ctx.strokeStyle=hover===r.target?'#e9ffbb':active?'#dff5d0b0':'#fff7d633';if(active){ctx.fillStyle=hover===r.target?'#c8f7a326':'#f4ffdd0b';ctx.beginPath();ctx.ellipse(r.x,r.y,r.w/2,r.h/2,0,0,TAU);ctx.fill();ctx.stroke();}
      }
      chip('Игрушки',150,310);chip('Для стирки',620,350);
    }else if(displayStage==='bed'){
      game.state.blanket.forEach((done,i)=>{if(done)return;const p=corners[i],x=i?530:200;ctx.strokeStyle='#fff9d7dd';ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(x,355);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='#e2f49fb0';ctx.beginPath();ctx.arc(x,355,25,0,TAU);ctx.fill();ctx.strokeStyle='#fcffe2';ctx.stroke();ctx.setLineDash([7,6]);});
      if(!game.state.pillow&&selected?.id==='pillow'){ctx.strokeStyle='#fff1bc';ctx.strokeRect(285,297,150,77);}
    }
    ctx.restore();
  }
  function draw(){
    if(!ctx)return;frames++;ctx.clearRect(0,0,W,W);
    if(atlas){const sw=atlas.width/3,x=Math.min(atlas.width-sw,Math.max(0,camera*sw));ctx.drawImage(atlas,x,0,sw,atlas.height,0,0,W,W);}else{ctx.fillStyle='#335e53';ctx.fillRect(0,0,W,W);}
    const shadow=ctx.createLinearGradient(0,520,0,720);shadow.addColorStop(0,'#0b281f00');shadow.addColorStop(1,'#0b281f22');ctx.fillStyle=shadow;ctx.fillRect(0,520,W,200);
    ctx.save();
    if(transition){const progress=Math.max(0,Math.min(1,(clock-transition.start)/transition.duration));ctx.globalAlpha=Math.abs(progress-.5)*2;}
    if(displayStage==='bed'){
      AdventureProps.blanket(ctx,{points:[corners[0],corners[1],{x:625,y:540},{x:100,y:540}],time:clock,settled:game.state.blanket.every(Boolean)});
      corners.forEach((p,i)=>{if(game.state.blanket[i])return;ctx.save();ctx.shadowColor='#ffeaaa';ctx.shadowBlur=15;ctx.fillStyle='#f8d876';ctx.beginPath();ctx.arc(p.x,p.y,18,0,TAU);ctx.fill();ctx.lineWidth=3;ctx.strokeStyle='#fff5c7';ctx.stroke();ctx.restore();});
    }
    if(displayStage==='bag'||displayStage==='done'){
      AdventureProps.bag(ctx,{x:360,y:550,packedImages:game.state.packed.map(id=>images[id]).filter(Boolean),zipProgress,hover:hover==='bag',ready:ready()});
      const count=data.pool.required.filter(id=>game.state.packed.includes(id)).length;for(let i=0;i<5;i++){ctx.fillStyle=i<count?'#d9ffab':'#ffffff45';ctx.beginPath();ctx.arc(310+i*25,658,5.5,0,TAU);ctx.fill();}
      if(displayStage==='bag'&&ready())chip('Потяни молнию →',360,390,true);
    }
    drawTargets();
    for(const s of sprites){if(displayStage==='bag'||displayStage==='done'){if(game.state.packed.includes(s.id)&&!s.grabbed&&Math.hypot(s.tx-s.x,s.ty-s.y)<3)continue;}if(!s.grabbed)drawSprite(s);}
    if(displayStage==='done'){
      const glow=ctx.createRadialGradient(687,435,20,687,435,270);glow.addColorStop(0,'#c6f9ef7a');glow.addColorStop(1,'#c6f9ef00');ctx.fillStyle=glow;ctx.fillRect(470,20,250,650);ctx.fillStyle='#d6fff080';ctx.beginPath();ctx.moveTo(664,90);ctx.lineTo(720,40);ctx.lineTo(720,650);ctx.lineTo(664,590);ctx.closePath();ctx.fill();
    }
    actor.draw(ctx);
    const dragged=sprites.find(s=>s.grabbed);if(dragged)drawSprite(dragged);
    for(const p of particles){ctx.globalAlpha=Math.min(1,p.life*2);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,TAU);ctx.fill();}ctx.globalAlpha=1;
    ctx.restore();
    if(started&&!selected&&!drag&&!transition&&displayStage==='floor'&&!Object.keys(game.state.placements).length)chip('Перенеси вещи на их места',360,40,true);
  }
  function choose(id,kind){
    selected={id,kind};feedbackOverride=kind==='corner'?'Выбран уголок. Потяни его к круглой метке или нажми на неё.':kind==='zip'?'Потяни молнию вправо до конца.':kind==='pillow'?'Выбрана подушка. Перенеси её к изголовью кровати.':'Выбрано: '+label(id)+'. Перенеси к подходящему месту или нажми на него.';updateUI();draw();
  }
  function action(type,payload,source){
    if(transition||!started)return {accepted:false};
    const before=game.state,response=game.act(type,payload);selected=null;feedbackOverride=response.message;
    if(response.accepted){
      tone('success');actorReaction='happy';reactionUntil=clock+.8;
      if(type==='dropFloor'){
        const s=sprites.find(v=>v.id===payload.id),p=floorDestination(payload.id,payload.zone);if(s){Object.assign(s,{tx:p.x,ty:p.y,ts:.55,ta:0,grabbed:false});burst(p.x,p.y);}
      }else if(type==='corner'){
        const p=corners[payload.index];p.tx=payload.index?530:200;p.ty=355;burst(p.tx,p.ty);
      }else if(type==='pillow'){
        const s=sprites.find(v=>v.id==='pillow');if(s)Object.assign(s,{tx:360,ty:334,ta:0,grabbed:false});burst(360,334);
      }else if(type==='pack'){
        const s=sprites.find(v=>v.id===payload.id);if(s)Object.assign(s,{tx:360,ty:512,ts:.3,ta:0,grabbed:false});burst(360,512);
      }else if(type==='unpack'){
        const s=sprites.find(v=>v.id===payload.id);if(s)Object.assign(s,{x:360,y:512,tx:s.ox,ty:s.oy,ts:1,s:.35,ta:0});
      }else if(type==='zip'){zipProgress=1;tone('success');}
      if(response.stageChanged){
        if(game.state.stage==='done'){displayStage='done';actorReaction='celebrate';finishAt=clock+(reduced?.05:6.5);}
        else if(reduced){displayStage=game.state.stage;camera=stageIndex[displayStage];setup(displayStage);}
        else transition={from:before.stage,to:game.state.stage,start:clock+.45,duration:.85,changed:false};
        drawer.hidden=true;drawers=null;
      }
      persist();
    }else{
      tone('return');actorReaction='think';reactionUntil=clock+.9;
      if(source&&source.id!=='zip'){const s=sprites.find(v=>v.id===source.id);if(s)Object.assign(s,{tx:s.ox,ty:s.oy,ts:1,ta:0,grabbed:false});}
      if(type==='zip')zipProgress=0;
    }
    updateUI();wake();return response;
  }
  function pointerPoint(event){const r=canvas.getBoundingClientRect();return {x:(event.clientX-r.left)/r.width*W,y:(event.clientY-r.top)/r.height*W};}
  function hitTarget(point){return regionList.filter(r=>r.kind==='zone').find(r=>Math.abs(r.x-point.x)<=Math.max(r.w/2,22/scale)&&Math.abs(r.y-point.y)<=Math.max(r.h/2,22/scale));}
  function performSelection(target){
    if(!selected){if(target==='bag'){openDrawer('bag');return;}return;}
    const current=selected;
    if(current.kind==='corner'){if(target===current.id)action('corner',{index:Number(current.id.slice(-1))});else{feedbackOverride='Для этого уголка подойдёт его метка у изголовья.';updateUI();}}
    else if(current.kind==='pillow'){if(target==='pillow-target')action('pillow',{});else{feedbackOverride='Подушка лежит у изголовья. Попробуй перенести её туда.';updateUI();}}
    else if(current.kind==='zip'){if(target==='zip-end')action('zip',{});}
    else if(displayStage==='floor')action('dropFloor',{id:current.id,zone:target},current);
    else if(displayStage==='bag')action('pack',{id:current.id},current);
  }
  scene.addEventListener('pointerdown',event=>{
    const hit=event.target.closest('.rg-hit');if(!hit||transition||!started)return;
    const kind=hit.dataset.rgKind;if(kind==='zone')return;
    event.preventDefault();const id=hit.dataset.rgItem,p=pointerPoint(event);choose(id,kind);drag={id,kind,pointerId:event.pointerId,start:p,point:p,moved:false};
    const s=sprites.find(v=>v.id===id);if(s){drag.offset={x:s.x-p.x,y:s.y-p.y};s.grabbed=true;s.ts=1.13;}
    try{scene.setPointerCapture(event.pointerId);}catch(_){}wake();
  });
  scene.addEventListener('pointermove',event=>{
    const p=pointerPoint(event);look={x:p.x,y:p.y};
    if(!drag||drag.pointerId!==event.pointerId)return;
    event.preventDefault();drag.point=p;if(Math.hypot(p.x-drag.start.x,p.y-drag.start.y)*scale>5)drag.moved=true;
    if(drag.kind==='corner'){const q=corners[Number(drag.id.slice(-1))];q.x=Math.max(70,Math.min(650,p.x));q.y=Math.max(300,Math.min(600,p.y));}
    else if(drag.kind==='zip')zipProgress=Math.max(0,Math.min(1,(p.x-250)/230));
    else{const s=sprites.find(v=>v.id===drag.id);if(s){s.x=p.x+(drag.offset?.x||0);s.y=p.y+(drag.offset?.y||0);s.angle=Math.max(-.17,Math.min(.17,(p.x-drag.start.x)*.001));}}
    hover=hitTarget(p)?.target||null;draw();
  },{passive:false});
  function endDrag(event,cancel){
    if(!drag||drag.pointerId!==event.pointerId)return;const d=drag;drag=null;suppressUntil=performance.now()+350;suppressDropClick=d.moved;
    try{scene.releasePointerCapture(event.pointerId);}catch(_){}
    const s=sprites.find(v=>v.id===d.id);if(s)s.grabbed=false;
    if(cancel){if(s)Object.assign(s,{tx:s.ox,ty:s.oy,ts:1,ta:0});if(d.kind==='corner'){const q=corners[Number(d.id.slice(-1))];q.tx=d.kind==='corner'&&d.id==='corner-0'?235:520;q.ty=d.id==='corner-0'?510:535;}zipProgress=0;wake();return;}
    if(!d.moved){if(s)Object.assign(s,{tx:s.ox,ty:s.oy,ts:1,ta:0});choose(d.id,d.kind);wake();return;}
    const p=pointerPoint(event),target=hitTarget(p)?.target;
    if(d.kind==='corner'){
      const i=Number(d.id.slice(-1)),dest={x:i?530:200,y:355};if(Math.hypot(p.x-dest.x,p.y-dest.y)<=Math.max(60,24/scale))action('corner',{index:i});
      else{corners[i].tx=i?520:235;corners[i].ty=i?535:510;feedbackOverride='Уголок можно потянуть к круглой метке у изголовья.';selected=null;updateUI();}
    }else if(d.kind==='pillow'){
      if(target==='pillow-target')action('pillow',{});else{if(s)Object.assign(s,{tx:s.ox,ty:s.oy,ts:1,ta:0});feedbackOverride='Положи подушку ближе к изголовью.';selected=null;updateUI();}
    }else if(d.kind==='zip'){
      if(zipProgress>.85)action('zip',{});else{zipProgress=0;selected=null;feedbackOverride='Проведи молнию вправо до конца.';updateUI();}
    }else if(displayStage==='floor')action('dropFloor',{id:d.id,zone:target||'floor'},d);
    else if(displayStage==='bag'){
      if(target==='bag'||p.x>215&&p.x<510&&p.y>480&&p.y<665)action('pack',{id:d.id},d);
      else{if(s)Object.assign(s,{tx:s.ox,ty:s.oy,ts:1,ta:0});selected=null;feedbackOverride='Сумка в центре. Можно перетащить вещь внутрь или выбрать и нажать на сумку.';updateUI();}
    }
    hover=null;wake();
  }
  scene.addEventListener('pointerup',event=>endDrag(event,false));scene.addEventListener('pointercancel',event=>endDrag(event,true));
  scene.addEventListener('click',event=>{
    const hit=event.target.closest('.rg-hit');if(!hit||transition||!started)return;
    if(event.detail!==0&&performance.now()<suppressUntil&&(suppressDropClick||hit.dataset.rgKind!=='zone'))return;
    if(hit.dataset.rgKind==='zone')performSelection(hit.dataset.rgTarget);else choose(hit.dataset.rgItem,hit.dataset.rgKind);
  });
  scene.addEventListener('dragstart',event=>event.preventDefault());
  function openDrawer(mode){
    if(displayStage!=='bag'||transition)return;drawers=mode;drawer.hidden=false;root.querySelector('[data-rg-drawer-title]').textContent=mode==='memo'?'Памятка бассейна':'Приготовленные вещи';
    const ids=mode==='memo'?data.pool.required:game.state.packed;
    const content='<div class="rg-drawer-grid">'+ids.map(id=>'<'+(mode==='bag'?'button type="button" data-rg-unpack="'+id+'"':'div')+' class="rg-item-chip'+(mode==='bag'?' cursor-interaction':'')+'"><img src="'+data.art[id]+'" alt=""><span>'+esc(label(id))+'</span></'+(mode==='bag'?'button':'div')+'>').join('')+'</div>';
    root.querySelector('[data-rg-drawer-body]').innerHTML=content+'<p class="rg-drawer-note">'+(mode==='memo'?'Очки и воду можно взять дополнительно.':'Нажми на вещь, если хочешь вернуть её на полку.')+'</p>';
  }
  root.querySelector('[data-rg-memo]').addEventListener('click',()=>openDrawer('memo'));
  root.querySelector('[data-rg-bag]').addEventListener('click',()=>openDrawer('bag'));
  root.querySelector('[data-rg-close]').addEventListener('click',()=>{drawer.hidden=true;drawers=null;});
  drawer.addEventListener('click',event=>{const button=event.target.closest('[data-rg-unpack]');if(!button)return;action('unpack',{id:button.dataset.rgUnpack});openDrawer('bag');});
  root.querySelector('[data-rg-sound]').addEventListener('click',event=>{soundEnabled=!soundEnabled;event.currentTarget.setAttribute('aria-pressed',String(soundEnabled));event.currentTarget.textContent=soundEnabled?'Звук: вкл.':'Звук: выкл.';if(soundEnabled){ensureAudio();tone('success');}persist();});
  startButton.addEventListener('click',()=>{if(!loaded)return;started=true;intro.hidden=true;if(soundEnabled)ensureAudio();feedbackOverride='';if(game.state.stage==='done'){displayStage='done';finished=true;}setup(displayStage);updateUI();wake();});
  root.querySelector('[data-rg-replay]').addEventListener('click',()=>{game.reset();displayStage='floor';camera=0;transition=null;finished=false;feedbackOverride='';setup('floor');updateUI();persist();wake();});
  // Some touch browsers suppress compatibility clicks after a captured drag.
  // Activate a genuine, stationary control tap on pointerup, deduplicating any
  // later native click. Drag sources keep their separate adapter; destination
  // buttons support the same stationary tap fallback as other controls.
  let controlTouch=null,lastControlTouch=null;
  root.addEventListener('pointerdown',event=>{
    lastControlTouch=null;
    if(event.pointerType!=='touch'||event.isPrimary===false)return;
    const button=event.target.closest('button');
    controlTouch=button&&!button.disabled&&(!button.classList.contains('rg-hit')||button.dataset.rgKind==='zone')?{button,id:event.pointerId,x:event.clientX,y:event.clientY}:null;
  });
  root.addEventListener('pointercancel',()=>{controlTouch=null;});
  root.addEventListener('pointerup',event=>{
    const tap=controlTouch;controlTouch=null;
    if(!tap||event.pointerType!=='touch'||tap.id!==event.pointerId||event.target.closest('button')!==tap.button||Math.hypot(event.clientX-tap.x,event.clientY-tap.y)>10||tap.button.disabled)return;
    event.preventDefault();lastControlTouch={button:tap.button,at:performance.now()};tap.button.click();
  });
  root.addEventListener('click',event=>{
    if(event.detail>0&&lastControlTouch&&performance.now()-lastControlTouch.at<700){event.preventDefault();event.stopImmediatePropagation();}
  },true);
  let actorReaction='idle',reactionUntil=0,look={x:360,y:400},lastStep=0;
  function update(dt){
    clock+=dt;
    if(transition){const progress=(clock-transition.start)/transition.duration;if(progress>=.5&&!transition.changed){transition.changed=true;displayStage=transition.to;setup(displayStage);feedbackOverride=game.state.message;updateUI();}const from=stageIndex[transition.from],to=stageIndex[transition.to],p=Math.max(0,Math.min(1,progress));camera=from+(to-from)*(p*p*(3-2*p));if(progress>=1){transition=null;camera=stageIndex[displayStage];updateUI();}}
    for(const s of sprites){if(s.grabbed)continue;if(reduced){s.x=s.tx;s.y=s.ty;s.s=s.ts;s.angle=s.ta;}else{const f=1-Math.exp(-10*dt);s.x+=(s.tx-s.x)*f;s.y+=(s.ty-s.y)*f;s.s+=(s.ts-s.s)*f;s.angle+=(s.ta-s.angle)*f;}}
    for(const p of corners){if(drag?.kind==='corner'&&corners[Number(drag.id.slice(-1))]===p)continue;if(reduced){p.x=p.tx;p.y=p.ty;}else{const f=1-Math.exp(-9*dt);p.x+=(p.tx-p.x)*f;p.y+=(p.ty-p.y)*f;}}
    particles=particles.filter(p=>p.life>0);for(const p of particles){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=160*dt;}
    const placed=game.state.placements;
    const target=displayStage==='done'?{x:678,y:645}:displayStage==='floor'?{x:placed['toy-car']?(placed.teddy?550:350):80,y:694}:displayStage==='bed'?{x:88,y:685}:{x:92,y:680};
    actor.update(dt,{targetX:target.x,targetY:target.y,mood:displayStage==='done'?'celebrate':clock<reactionUntil?actorReaction:!Object.keys(game.state.placements).length&&displayStage==='floor'?'think':'idle',lookX:look.x,lookY:look.y,reducedMotion:reduced});
    if(actor.moving&&clock-lastStep>.28){tone('step');lastStep=clock;}
    if(displayStage==='done'&&!finished&&(reduced||clock>=finishAt&&Math.abs(actor.x-678)<8)){finished=true;feedbackOverride=instructions.done;burst(650,560);updateUI();}
  }
  function tick(timestamp){raf=0;if(!started||!visible||!root.isConnected)return;const dt=last?Math.min(.045,(timestamp-last)/1000):0;last=timestamp;update(dt);draw();raf=requestAnimationFrame(tick);}
  function wake(){if(started&&visible&&!raf){last=0;raf=requestAnimationFrame(tick);}else if(!started)draw();}
  function visibility(){visible=intersecting&&!document.hidden;if(!visible){if(raf)cancelAnimationFrame(raf);raf=0;last=0;audio?.suspend?.().catch(()=>{});}else{if(soundEnabled&&audio?.state==='suspended')audio.resume().catch(()=>{});wake();}}
  document.addEventListener('visibilitychange',visibility);window.addEventListener('pagehide',()=>{intersecting=false;visibility();});
  if(window.IntersectionObserver)new IntersectionObserver(entries=>{intersecting=entries[0]?.isIntersecting!==false;visibility();},{threshold:0}).observe(canvas);
  if(window.ResizeObserver)new ResizeObserver(resize).observe(scene);else window.addEventListener('resize',resize);
  store.subscribe(()=>{saveNotice();});

  window.AdventureGame=Object.freeze({snapshot:()=>({state:game.state,displayStage,started,selected:selected?{...selected}:null,actor:{x:actor.x,y:actor.y,time:actor._time,moving:actor.moving},frames,visible,transitioning:!!transition,clock,finished,loaded,reducedMotion:reduced,zipProgress}),regions:()=>Array.from(hits.querySelectorAll('.rg-hit')).map(el=>{const b=el.getBoundingClientRect();return {kind:el.dataset.rgKind,item:el.dataset.rgItem||null,target:el.dataset.rgTarget||null,x:b.x,y:b.y,width:b.width,height:b.height,centerX:b.x+b.width/2,centerY:b.y+b.height/2};})});
  setup(displayStage);resize();updateUI();
  Promise.all([image(data.atlas).then(img=>atlas=img),...Object.entries(data.art).map(([id,src])=>image(src).then(img=>images[id]=img))]).then(()=>{loaded=!!atlas;updateUI();draw();if(!loaded){startButton.textContent='Комната не загрузилась';feedbackOverride='Изображение комнаты не загрузилось. Попробуй открыть пример ещё раз.';feedback.textContent=feedbackOverride;}});
});
global.RoomGame=Object.freeze({mount,assets:()=>({atlas:ATLAS}),launcher(){return '<a class="room-launch" href="?room=1"><span class="room-launch-picture" aria-hidden="true"><img src="'+ATLAS+'" alt=""></span><span><strong>Приключение с Рэем</strong><small>Наведи порядок, расправь покрывало и собери сумку в бассейн →</small></span></a>';}});
})(typeof window==='undefined'?globalThis:window);
